// HackOps data model. Spec: docs/spec.md §6; design notes: docs/phases/02-core-data-and-api.md.
// SQLite has no enums or list columns: enum-like fields are strings checked by Zod in @hackops/shared,
// and lists are JSON strings parsed at the API boundary.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model Hackathon {
  id                   String       @id @default(cuid())
  source               String // devpost | mlh | my-list | manual | demo
  sourceId             String?
  title                String
  url                  String
  organizer            String?
  mode                 String // online | in_person | hybrid
  city                 String?
  country              String?
  startsAt             DateTime?
  endsAt               DateTime?
  registrationClosesAt DateTime?
  submissionDueAt      DateTime?
  judgingAt            DateTime?
  prizeAmount          Int?
  prizeCurrency        String?
  teamSizeMax          Int?
  eligibility          String?
  prizeTracks          String       @default("[]") // JSON: { name, sponsor?, prize? }[]
  stage                String       @default("discovered")
  decisionNote         String?
  result               String? // won | finalist | participated
  resultNote           String?
  retroWentWell        String?
  retroToChange        String?
  ownerId              String?
  owner                Member?      @relation("owner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectId            String?
  project              Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  categories           Category[]
  assignments          Assignment[]
  tasks                Task[]
  activity             Activity[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([source, sourceId])
  @@index([stage])
}

model Category {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  keywords   String      @default("[]") // JSON: string[]
  hackathons Hackathon[]
}

model Member {
  id             String       @id @default(cuid())
  name           String
  email          String?
  githubUrl      String?
  linkedinUrl    String?
  skills         String       @default("[]") // JSON: string[]
  preferredRoles String       @default("[]") // JSON: Role[]
  organisation   String?
  tshirtSize     String?
  dietary        String?
  owned          Hackathon[]  @relation("owner")
  assignments    Assignment[]
  tasks          Task[]
  activity       Activity[]
}

model Assignment {
  hackathonId String
  memberId    String
  role        String // lead | developer | designer | pitch
  accountable Boolean   @default(false)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([hackathonId, memberId])
}

model Task {
  id          String    @id @default(cuid())
  hackathonId String
  title       String
  status      String    @default("todo") // todo | doing | done
  assigneeId  String?
  dueAt       DateTime?
  order       Int       @default(0)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  assignee    Member?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([hackathonId])
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  tech        String      @default("[]") // JSON: string[]
  repoUrl     String?
  demoUrl     String?
  videoUrl    String?
  slidesUrl   String?
  devpostUrl  String?
  hackathons  Hackathon[]
}

model Activity {
  id          String    @id @default(cuid())
  hackathonId String
  memberId    String?
  kind        String // change | note
  text        String
  createdAt   DateTime  @default(now())
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([hackathonId, createdAt])
}

model Team {
  id            String  @id @default("team")
  name          String
  pitch         String?
  preferredTech String  @default("[]") // JSON: string[]
  preferredCats String  @default("[]") // JSON: category slugs
  homeCity      String  @default("Kuala Lumpur")
}
