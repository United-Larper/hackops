// HackOps data model. Spec: docs/spec.md §6; design notes: docs/phases/02-core-data-and-api.md.
// Postgres on Neon. Enum-like fields are strings checked by Zod in @hackops/shared (no enum migrations); lists are Postgres arrays.
// Categories are the CATEGORIES constant in @hackops/shared; a hackathon stores their slugs.
// The database also checks that result is set only at stage "results" (a CHECK in the 20261128000000 migration: Prisma can't model it).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Hackathon {
  id                   String       @id @default(cuid())
  source               String // devpost | mlh | my-list | demo
  sourceId             String?
  title                String
  url                  String
  organizer            String?
  mode                 String // online | in_person | hybrid
  city                 String?
  country              String?
  startsAt             DateTime?
  endsAt               DateTime?
  registrationClosesAt DateTime?
  submissionDueAt      DateTime?
  judgingAt            DateTime?
  prizeAmount          Int?
  prizeCurrency        String?
  teamSizeMax          Int?
  eligibility          String?
  prizeTracks          Json         @default("[]") // { name, sponsor?, prize? }[]
  stage                String       @default("discovered")
  decisionNote         String?
  result               String? // won | finalist | participated
  resultNote           String?
  retroWentWell        String?
  retroToChange        String?
  projectId            String?
  project              Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  categories           String[]     @default([]) // slugs from CATEGORIES
  assignments          Assignment[]
  tasks                Task[]
  activity             Activity[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([source, sourceId])
  @@index([stage])
}

model Member {
  id             String        @id @default(cuid())
  name           String
  email          String?       @unique // login; lowercased by MemberInput
  githubUrl      String?
  linkedinUrl    String?
  portfolioUrl   String? // personal site
  skills         String[]      @default([])
  preferredRoles String[]      @default([]) // Role[]
  organisation   String?
  tshirtSize     String?
  dietary        String?
  assignments    Assignment[]
  tasks          Task[]
  activity       Activity[]
  secret         MemberSecret?
  sessions       Session[]
}

// Secrets live apart from Member, so spreading a Member row into a response can never leak them.
model MemberSecret {
  memberId     String  @id
  passwordHash String? // scrypt$salt$hash; null until set-password or the seed sets one
  fillToken    String? @unique // this member's bookmarklet and calendar-feed secret
  totpSecret   String? // two-step sign-in key (base32); null when it's off
  totpLastStep Int? // the last code's 30-second step, so a code works once
  member       Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Session {
  tokenHash String   @id // sha256 of the token; the token itself is only in the person's cookie
  memberId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Assignment {
  hackathonId String
  memberId    String
  role        String // lead | developer | designer | pitch
  accountable Boolean   @default(false)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([hackathonId, memberId])
}

model Task {
  id          String    @id @default(cuid())
  hackathonId String
  title       String
  status      String    @default("todo") // todo | doing | done
  assigneeId  String?
  dueAt       DateTime?
  order       Int       @default(0)
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  assignee    Member?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([hackathonId])
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  tech        String[]    @default([])
  repoUrl     String?
  demoUrl     String?
  videoUrl    String?
  slidesUrl   String?
  devpostUrl  String?
  hackathons  Hackathon[]
}

model Activity {
  id          String    @id @default(cuid())
  hackathonId String
  memberId    String?
  kind        String // change | note
  text        String
  createdAt   DateTime  @default(now())
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([hackathonId, createdAt])
}

model Team {
  id    String  @id @default("team") // TEAM_ID: the one row
  name  String
  pitch String?
}

// Failed sign-ins in the last 15 minutes, by email and by the browser's address. In the database so an API
// restart doesn't reset the lockout.
model LoginFailure {
  id      String   @id @default(cuid())
  email   String
  address String
  at      DateTime @default(now())

  @@index([email, at])
  @@index([address, at])
}
