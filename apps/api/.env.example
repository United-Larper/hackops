PORT=4000
# Neon: Dashboard → Connect. The pooled URL (host has "-pooler") is for the app; the direct one for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Local only, also when hosted: only the web app on this machine may reach the API (see Hosting in the README).
HOST=127.0.0.1
# Optional: demo members get this password when seeding (10+ characters).
# SEED_PASSWORD=
# db:seed keeps only this member (and removes every other member and every project).
SEED_MEMBER_NAME=
SEED_MEMBER_EMAIL=
